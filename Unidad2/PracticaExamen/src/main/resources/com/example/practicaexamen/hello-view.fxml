<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.practicaexamen.HelloController">
    <children>
        <Label text="Listado de usuarios desde archivo" />
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints />
            </rowConstraints>
            <children>
                <Label text="Nombre" />
                <Label text="Teléfono" GridPane.rowIndex="1" />
                <Label text="Parentesco" GridPane.rowIndex="2" />

                <TextField fx:id="txtNombre" GridPane.columnIndex="1" />
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbParentesco" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onBuscarClick" text="Recargar info" />
                <Button mnemonicParsing="false" onAction="#onAgregarClick" text="Agregar" />
                <Button mnemonicParsing="false" onAction="#onActualizarClick" text="Actualizar" />
                <Button mnemonicParsing="false" onAction="#onEliminarClick" text="Eliminar" />
            </children>
        </HBox>
        <ListView fx:id="listView" prefHeight="200.0" prefWidth="200.0" />
        <Label fx:id="lblMsg" />
    </children>
</VBox>
